DATABASE_URI=
PAYLOAD_SECRET=
CRON_SECRET=

PAYLOAD_CLOUD=
PAYLOAD_CLOUD_ENVIRONMENT=
PAYLOAD_CLOUD_COGNITO_USER_POOL_CLIENT_ID=
PAYLOAD_CLOUD_COGNITO_USER_POOL_ID=
PAYLOAD_CLOUD_COGNITO_IDENTITY_POOL_ID=
PAYLOAD_CLOUD_PROJECT_ID=
PAYLOAD_CLOUD_BUCKET=
PAYLOAD_CLOUD_BUCKET_REGION=

# Copy this value from 'Cognito Password' field on File Storage page
PAYLOAD_CLOUD_COGNITO_PASSWORD=

NEXT_PUBLIC_SERVER_URL=

# optional ----------
NEXT_PUBLIC_IS_LIVE=
NEXT_PUBLIC_USE_PAYLOAD_CLOUD=
UMAMI_URI=
UMAMI_WEBSITE_ID=

# Sentry: the public DSN enables error reporting; the auth token (org:ci scope) lets the build
# upload source maps and is only needed on Payload Cloud. NEXT_PUBLIC_* values are inlined into
# the browser bundle at build time, so changing them needs a rebuild to reach the client.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

DATABASE_URI=
PAYLOAD_SECRET=
CRON_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Set by Payload Cloud itself -- leave every PAYLOAD_CLOUD_* value empty locally. The storage
# plugin only registers when PAYLOAD_CLOUD is true, so a local run never reaches for S3.
PAYLOAD_CLOUD=
# Logs bucket names, S3 keys and Cognito details. Only turn this on while debugging storage.
PAYLOAD_CLOUD_DEBUG=
PAYLOAD_CLOUD_ENVIRONMENT=
PAYLOAD_CLOUD_COGNITO_USER_POOL_CLIENT_ID=
PAYLOAD_CLOUD_COGNITO_USER_POOL_ID=
PAYLOAD_CLOUD_COGNITO_IDENTITY_POOL_ID=
PAYLOAD_CLOUD_PROJECT_ID=
PAYLOAD_CLOUD_BUCKET=
PAYLOAD_CLOUD_BUCKET_REGION=

# Copy this value from 'Cognito Password' field on File Storage page
PAYLOAD_CLOUD_COGNITO_PASSWORD=

NEXT_PUBLIC_SERVER_URL=

# optional ----------
# 'false' (the default) serves a noindex header on every response.
NEXT_PUBLIC_IS_LIVE=
# Our own switch for the storage plugin. It also needs PAYLOAD_CLOUD, which the platform sets,
# so leaving this at its 'true' default changes nothing outside Payload Cloud.
NEXT_PUBLIC_USE_PAYLOAD_CLOUD=
UMAMI_URI=
UMAMI_WEBSITE_ID=

# Sentry: the public DSN enables error reporting; the auth token (org:ci scope) lets the build
# upload source maps and is only needed on Payload Cloud. NEXT_PUBLIC_* values are inlined into
# the browser bundle at build time, so changing them needs a rebuild to reach the client.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
